;; signal-orchestrator-message — semantic payload carried inside the opaque
;; orchestrator message body.
;;
;; Payload-only: this contract owns no request/reply channel. The message kind
;; is semantic, not a transport signal. Threading is transport-level and is not
;; modelled here. `HardInterruption` is deliberately reserved-absent.
;;
;; Rust source owns the vertical slice directly; this concept schema names the
;; payload records for generator alignment.
[]
[]
{
  MessageSubject String
  MessageContent String
  GuidanceMagnitude [Soft Standard Hard]
  OrchestratorMessageKind [(Guidance GuidanceMagnitude) Interruption Report]
  OrchestratorMessage { kind.OrchestratorMessageKind subject.MessageSubject content.MessageContent }
}
